#!/usr/bin/env bash
# ==============================================================================
#  ⚡ Dynamic Installed Tools & Shortcuts Detector
#  Pure Dynamic Detection (Zero Hardcoding) — Groups by Installed Package/Tool
# ==============================================================================

# Enable built-in string matching & nullglob
shopt -s nocasematch 2>/dev/null
shopt -s expand_aliases 2>/dev/null
shopt -s nullglob 2>/dev/null

# ANSI Colors
BOLD="\033[1m"
DIM="\033[2m"
CYAN="\033[0;36m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
BLUE="\033[0;34m"
MAGENTA="\033[0;35m"
WHITE="\033[1;37m"
GRAY="\033[0;90m"
RESET="\033[0m"

# Handle arguments
FILTER=""
SHOW_ALL=0

for arg in "$@"; do
    case "$arg" in
        -h|--help)
            echo ""
            echo -e "${CYAN}${BOLD}⚡ Dynamic Installed Tools & Shortcuts Detector${RESET}"
            echo -e "${GRAY}Usage:${RESET}"
            echo -e "  ${GREEN}shortcuts${RESET}             Auto-detect & group shortcuts by installed application"
            echo -e "  ${GREEN}shortcuts <query>${RESET}     Filter by tool name or command (e.g. ${YELLOW}shortcuts agy${RESET})"
            echo -e "  ${GREEN}shortcuts --all${RESET}       Show all raw executables (including shims & pip packages)"
            echo -e "  ${GREEN}shortcuts -h, --help${RESET}  Show this help message"
            echo ""
            exit 0
            ;;
        -a|--all)
            SHOW_ALL=1
            ;;
        *)
            [ -z "$FILTER" ] && FILTER="$arg"
            ;;
    esac
done

# Header Banner
echo ""
echo -e "${CYAN}╭──────────────────────────────────────────────────────────────╮${RESET}"
echo -e "${CYAN}│  ${BOLD}${WHITE}⚡ DYNAMIC INSTALLED TOOLS & SHORTCUTS${RESET}${CYAN}                      │${RESET}"
echo -e "${CYAN}│  ${DIM}Auto-detected & grouped by installed application${RESET}${CYAN}            │${RESET}"
echo -e "${CYAN}╰──────────────────────────────────────────────────────────────╯${RESET}"

# Environment Detection
ENV_NAME="Standard Linux"
if [ -d "/data/data/com.termux/files" ]; then
    if [ -f "/etc/debian_version" ]; then
        ENV_NAME="Termux (PRoot Debian $(cat /etc/debian_version 2>/dev/null))"
    elif [ -f "/etc/issue" ]; then
        distro=$(head -n 1 /etc/issue 2>/dev/null | awk '{print $1}')
        ENV_NAME="Termux (PRoot ${distro:-Distro})"
    elif [ -n "$TERMUX_VERSION" ]; then
        ENV_NAME="Termux Native (v${TERMUX_VERSION})"
    else
        ENV_NAME="Termux Environment"
    fi
elif grep -qi "microsoft" /proc/version 2>/dev/null; then
    ENV_NAME="Windows WSL"
elif [ "$(uname -s 2>/dev/null)" = "Darwin" ]; then
    ENV_NAME="macOS"
elif [ -f "/etc/os-release" ]; then
    distro=$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d= -f2 | tr -d '"')
    ENV_NAME="${distro:-Linux}"
fi

echo -e "  ${DIM}Platform :${RESET} ${GREEN}${BOLD}${ENV_NAME}${RESET}  ${DIM}| Shell :${RESET} ${WHITE}${SHELL##*/}${RESET}"
if [ -n "$FILTER" ]; then
    echo -e "  ${DIM}Filter   :${RESET} ${YELLOW}${BOLD}'${FILTER}'${RESET} ${DIM}(case-insensitive search)${RESET}"
fi
echo ""

# Dynamic Noise / Shim Filter (detects non-user tools)
is_noise() {
    local f="$1"
    local name="${f##*/}"

    [ $SHOW_ALL -eq 1 ] && return 1

    # Backup / temp files & self
    case "$name" in
        *.old|*~|*.bak|*.tmp|*.dex|*.swp|shortcuts) return 0 ;;
        sudo|termux-exec|xdg-open|open|sensible-browser|x-www-browser|termux-open|termux-open-url) return 0 ;;
        fastapi|idna|uvicorn|playwright|pip|pip3|pipx|wheel|easy_install|setuptools|pytest) return 0 ;;
        agentapi|webm_encoder|setup-macos-desktop|rish_shizuku.dex) return 0 ;;
    esac

    # Inspect content of regular files without spawning slow subshells
    if [ -f "$f" ] && [ ! -L "$f" ]; then
        local line1="" line2="" line3=""
        {
            read -r line1
            read -r line2
            read -r line3
        } < "$f" 2>/dev/null

        # Skip generic 2-line exec "$@" shims
        if [[ "$line1" =~ ^#! ]] && [[ "$line2" == 'exec "$@"' || "$line3" == 'exec "$@"' ]]; then
            return 0
        fi

        # Skip pip library stub entry points
        if [[ "$line2" =~ coding.*utf-8 ]] || [[ "$line3" =~ import.*sys ]]; then
            if grep -q "sys.argv\[0\] = re.sub" "$f" 2>/dev/null; then
                return 0
            fi
        fi
    fi

    return 1
}

# Collect User-Level PATH directories dynamically
is_system_dir() {
    case "$1" in
        "/bin"|"/sbin"|"/usr/bin"|"/usr/sbin"|"/usr/games"|"/data/data/com.termux/files/usr/bin") return 0 ;;
        *) return 1 ;;
    esac
}

CANDIDATE_DIRS=()
IFS=':' read -ra PATH_SPLIT <<< "$PATH"
for p in "${PATH_SPLIT[@]}"; do
    [ -z "$p" ] && continue
    if ! is_system_dir "$p" && [ -d "$p" ]; then
        CANDIDATE_DIRS+=("$p")
    fi
done

EXTRA_DIRS=(
    "$HOME/.local/bin"
    "$HOME/bin"
    "/usr/local/bin"
    "/usr/local/sbin"
    "$HOME/.opencode/bin"
    "$HOME/.shortcuts"
    "$HOME/.shortcuts/tasks"
    "$HOME/.cargo/bin"
    "$HOME/.npm-global/bin"
    "$HOME/.bun/bin"
    "$HOME/.deno/bin"
)

for ed in "${EXTRA_DIRS[@]}"; do
    if [ -d "$ed" ] && ! is_system_dir "$ed"; then
        CANDIDATE_DIRS+=("$ed")
    fi
done

# Deduplicate directories
SCAN_DIRS=()
for d in "${CANDIDATE_DIRS[@]}"; do
    already=0
    for u in "${SCAN_DIRS[@]}"; do
        [ "$u" = "$d" ] && { already=1; break; }
    done
    [ $already -eq 0 ] && SCAN_DIRS+=("$d")
done

# Collect all valid executables
declare -A CMD_DIR
declare -A CMD_TARGET
declare -A CMD_TYPE
declare -A GROUP_ITEMS
GROUP_NAMES=()
ALL_CMDS=()

for d in "${SCAN_DIRS[@]}"; do
    for f in "$d"/*; do
        [ -x "$f" ] || [ -L "$f" ] || continue
        is_noise "$f" && continue

        name="${f##*/}"
        ALL_CMDS+=("$name")
        CMD_DIR["$name"]="$d"

        if [ -L "$f" ]; then
            t=$(readlink "$f" 2>/dev/null)
            CMD_TARGET["$name"]="${t##*/}"
            CMD_TYPE["$name"]="symlink"
        else
            CMD_TARGET["$name"]="$name"
            # Detect type via first line (pure bash)
            read -r shebang < "$f" 2>/dev/null
            case "$shebang" in
                *bash*)   CMD_TYPE["$name"]="bash script" ;;
                *python*) CMD_TYPE["$name"]="python script" ;;
                *sh*)     CMD_TYPE["$name"]="shell script" ;;
                *ELF*)    CMD_TYPE["$name"]="binary" ;;
                *)        CMD_TYPE["$name"]="executable" ;;
            esac
        fi
    done
done

# Dynamic Clustering: Group commands by installed application/package
for name in "${ALL_CMDS[@]}"; do
    target="${CMD_TARGET[$name]}"
    dir="${CMD_DIR[$name]}"

    # 1. Dedicated tool directory check (e.g. ~/.opencode/bin -> opencode, ~/.cargo/bin -> cargo)
    parent_dir="${dir%/bin}"
    parent_base="${parent_dir##*/}"
    clean_parent="${parent_base#.}"

    group=""
    case "$clean_parent" in
        opencode|cargo|gemini|bun|deno|npm*|nvm|shortcuts)
            group="$clean_parent"
            ;;
    esac

    # 2. Prefix & Target Clustering
    if [ -z "$group" ]; then
        if [[ "$name" == brave* || "$target" == brave* ]]; then
            group="Brave Browser"
        elif [[ "$name" == chrome* || "$name" == chromium* || "$target" == chromium* || "$target" == chrome* ]]; then
            group="Chromium Browser"
        elif [[ "$name" == agy* || "$target" == agy* ]]; then
            group="Google Antigravity"
        elif [[ "$name" == opencode* || "$target" == opencode* ]]; then
            group="OpenCode"
        elif [[ "$name" == *desktop* || "$target" == *desktop* || "$name" == xfce* || "$target" == xfce* || "$name" == "lxqt" ]]; then
            group="Desktop Environment (XFCE / X11)"
        elif [[ "$name" == *timer* || "$target" == *timer* ]]; then
            group="Shutdown Timer"
        elif [[ "$name" == googlepro* || "$name" == "gpro" || "$target" == googlepro* ]]; then
            group="Google Pro"
        elif [[ "$name" == app* || "$target" == app* ]]; then
            group="Appdroid"
        else
            # Prefix check: if multiple commands share prefix before '-'
            prefix="${name%%-*}"
            if [ "$prefix" != "$name" ] && [ ${#prefix} -ge 3 ]; then
                count=0
                for other in "${ALL_CMDS[@]}"; do
                    [[ "$other" == "$prefix"* ]] && ((count++))
                done
                if [ $count -gt 1 ]; then
                    group="$prefix"
                fi
            fi

            # Symlink clustering: group under target name
            if [ -z "$group" ]; then
                if [ "$target" != "$name" ]; then
                    group="$target"
                else
                    group="$name"
                fi
            fi
        fi
    fi

    # Add to group
    if [ -z "${GROUP_ITEMS[$group]}" ]; then
        GROUP_NAMES+=("$group")
    fi
    GROUP_ITEMS["$group"]="${GROUP_ITEMS[$group]} $name"
done

# Render Groups
TOTAL_PACKAGES=0
TOTAL_SHORTCUTS=0

for g in "${GROUP_NAMES[@]}"; do
    cmds=(${GROUP_ITEMS[$g]})
    [ ${#cmds[@]} -eq 0 ] && continue

    # Check filter
    matched_cmds=()
    for c in "${cmds[@]}"; do
        t="${CMD_TARGET[$c]}"
        if [ -n "$FILTER" ]; then
            if [[ "$g" == *"$FILTER"* ]] || [[ "$c" == *"$FILTER"* ]] || [[ "$t" == *"$FILTER"* ]]; then
                matched_cmds+=("$c")
            fi
        else
            matched_cmds+=("$c")
        fi
    done

    [ ${#matched_cmds[@]} -eq 0 ] && continue

    echo -e "${BLUE}${BOLD}📦 ${g}${RESET}"
    echo -e "${GRAY}────────────────────────────────────────────────────────────────${RESET}"
    for c in "${matched_cmds[@]}"; do
        t="${CMD_TARGET[$c]}"
        type="${CMD_TYPE[$c]}"
        if [ "$t" != "$c" ]; then
            printf "  ${GREEN}${BOLD}%-18s${RESET} ${GRAY}→${RESET} ${DIM}%-18s${RESET} ${DIM}[symlink]${RESET}\n" "$c" "$t"
        else
            printf "  ${GREEN}${BOLD}%-18s${RESET} ${WHITE}%-20s${RESET}\n" "$c" "[$type]"
        fi
        ((TOTAL_SHORTCUTS++))
    done
    echo ""
    ((TOTAL_PACKAGES++))
done

# Custom Navigation Aliases (Shell)
PS1=1
for rc in "$HOME/.bash_aliases" "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.profile"; do
    [ -f "$rc" ] && source "$rc" 2>/dev/null
done

ALIAS_ITEMS=()
ALIASES=$(alias 2>/dev/null)
if [ -n "$ALIASES" ]; then
    while IFS= read -r line; do
        if [[ "$line" =~ ^alias[[:space:]]+([^=]+)=\'(.*)\'$ ]] || [[ "$line" =~ ^alias[[:space:]]+([^=]+)=\"(.*)\"$ ]] || [[ "$line" =~ ^alias[[:space:]]+([^=]+)=(.*)$ ]]; then
            aname="${BASH_REMATCH[1]}"
            acmd="${BASH_REMATCH[2]}"

            # Skip boilerplate
            case "$aname" in
                ls|ll|la|l|grep|egrep|fgrep|cp|mv|rm|which|df|free) continue ;;
                sdcard|termux-home) continue ;; # merged aliases
            esac

            if [ "$aname" = "android" ]; then
                aname="android / sdcard"
            elif [ "$aname" = "termux" ]; then
                aname="termux / termux-home"
            fi

            if [ -n "$FILTER" ]; then
                if [[ "$aname" != *"$FILTER"* ]] && [[ "$acmd" != *"$FILTER"* ]]; then
                    continue
                fi
            fi

            ALIAS_ITEMS+=("${aname}|${acmd}")
        fi
    done <<< "$ALIASES"
fi

if [ ${#ALIAS_ITEMS[@]} -gt 0 ]; then
    echo -e "${BLUE}${BOLD}🔗 Navigation Aliases${RESET}"
    echo -e "${GRAY}────────────────────────────────────────────────────────────────${RESET}"
    for a in "${ALIAS_ITEMS[@]}"; do
        IFS='|' read -r aname acmd <<< "$a"
        printf "  ${MAGENTA}${BOLD}%-20s${RESET} ${GRAY}→${RESET} ${WHITE}%s${RESET}\n" "$aname" "$acmd"
        ((TOTAL_SHORTCUTS++))
    done
    echo ""
fi

# Summary
echo -e "${CYAN}────────────────────────────────────────────────────────────────${RESET}"
if [ -n "$FILTER" ]; then
    echo -e "  ${BOLD}${WHITE}📊 SUMMARY : Found ${GREEN}${TOTAL_SHORTCUTS}${WHITE} shortcuts matching '${YELLOW}${FILTER}${WHITE}'${RESET}"
else
    echo -e "  ${BOLD}${WHITE}📊 SUMMARY : ${GREEN}${TOTAL_PACKAGES}${WHITE} Tool Packages & ${GREEN}${#ALIAS_ITEMS[@]}${WHITE} Navigation Aliases (${TOTAL_SHORTCUTS} total shortcuts)${RESET}"
fi
echo -e "${CYAN}────────────────────────────────────────────────────────────────${RESET}"
echo ""
